generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Zaposlenik {
  id        Int    @id @default(autoincrement())
  ime       String
  prezime   String @default("")
  pozicija  String
  godisnji  Int

  odmori    GodisnjiOdmor[]
  korisnik  Korisnik?
}

model GodisnjiOdmor {
  id                  Int      @id @default(autoincrement())
  zaposlenikId        Int
  vrsta               String   @default("Godišnji odmor")
  od                  DateTime
  do                  DateTime
  status              String   @default("na čekanju")
  napomena            String?
  odbijaSeOdGodisnjeg Boolean  @default(true)

  zaposlenik          Zaposlenik @relation(fields: [zaposlenikId], references: [id])
}

model Korisnik {
  id           Int     @id @default(autoincrement())
  ime          String
  prezime      String  @default("")
  email        String  @unique
  lozinka      String
  uloga        String  @default("zaposlenik")
  odobren      Boolean @default(false)

  zaposlenikId Int?   @unique
  zaposlenik   Zaposlenik? @relation(fields: [zaposlenikId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  korisnik  String
  akcija    String
  detalji   String?
  createdAt DateTime @default(now())
}