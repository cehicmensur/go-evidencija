generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Zaposlenik {
  id                     Int             @id @default(autoincrement())
  ime                    String
  pozicija               String
  godisnji               Int
  dodatniDani            Int             @default(0)
  prethodniStazGodina    Int             @default(0)
  prethodniStazMjeseci   Int             @default(0)
  datumPocetka           DateTime?
  brojDjeceU15           Int             @default(0)
  invaliditet            Boolean         @default(false)
  mjeseciARBiH           Int             @default(0)
  nivoSluzbenickogMjesta String          @default("ostalo")
  ocjenaRezultata        String          @default("bez")
  samohraniRoditelj      Boolean         @default(false)
  odmori                 GodisnjiOdmor[]
  dokumenti Dokument[]
  korisnik               Korisnik?
  radniStazovi           RadniStaz[]
  obracuniGO ObracunGO[]
}

model RadniStaz {
  id           Int        @id @default(autoincrement())
  zaposlenikId Int
  poslodavac   String
  datumOd      DateTime
  datumDo      DateTime
  zaposlenik   Zaposlenik @relation(fields: [zaposlenikId], references: [id])
}
model Dokument {
  id            Int          @id @default(autoincrement())

  zaposlenikId  Int
  zaposlenik    Zaposlenik   @relation(fields: [zaposlenikId], references: [id], onDelete: Cascade)

  naziv         String
  vrsta         String
  opis          String?

  datum         DateTime

  datoteka      String

  createdAt     DateTime     @default(now())
}

model GodisnjiOdmor {
  id                  Int        @id @default(autoincrement())
  zaposlenikId        Int
  od                  DateTime
  do                  DateTime
  status              String     @default("na čekanju")
  napomena            String?
  odbijaSeOdGodisnjeg Boolean    @default(true)
  vrsta               String     @default("Godišnji odmor")
  zaposlenik          Zaposlenik @relation(fields: [zaposlenikId], references: [id])
}

model Korisnik {
  id           Int         @id @default(autoincrement())
  ime          String
  email        String      @unique
  lozinka      String
  uloga        String      @default("zaposlenik")
  zaposlenikId Int?        @unique
  odobren      Boolean     @default(false)
  zaposlenik   Zaposlenik? @relation(fields: [zaposlenikId], references: [id])
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

model NeradniDan {
  id    Int      @id @default(autoincrement())
  naziv String
  datum DateTime
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  korisnik  String
  akcija    String
  detalji   String?
  createdAt DateTime @default(now())
}

model ObracunGO {
  id             Int        @id @default(autoincrement())

  zaposlenikId   Int
  zaposlenik     Zaposlenik @relation(fields: [zaposlenikId], references: [id], onDelete: Cascade)

  godina         Int

  brojDanaGO     Int

  datumObracuna  DateTime   @default(now())

  @@unique([zaposlenikId, godina])
}
