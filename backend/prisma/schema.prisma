generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Zaposlenik {
  id Int @id @default(autoincrement())

  ime      String
  pozicija String

  datumPocetka DateTime?

  godisnji Int

  prethodniStazGodina  Int @default(0)
  prethodniStazMjeseci Int @default(0)

  dodatniDani Int @default(0)

brojDjeceU15          Int      @default(0)
samohraniRoditelj     Boolean  @default(false)
invaliditet           Boolean  @default(false)

nivoSluzbenickogMjesta String  @default("ostalo")
ocjenaRezultata        String  @default("bez")

mjeseciARBiH          Int      @default(0)

  odmori   GodisnjiOdmor[]
  korisnik Korisnik?

  radniStazovi RadniStaz[]
  obracuni GodisnjiObracun[]
}

model RadniStaz {
  id           Int      @id @default(autoincrement())
  zaposlenikId Int
  poslodavac   String
  datumOd      DateTime
  datumDo      DateTime

  zaposlenik Zaposlenik @relation(fields: [zaposlenikId], references: [id])
}

model GodisnjiOdmor {
  id                  Int        @id @default(autoincrement())
  zaposlenikId        Int
  od                  DateTime
  do                  DateTime
  status              String     @default("na čekanju")
  napomena            String?
  odbijaSeOdGodisnjeg Boolean    @default(true)
  vrsta               String     @default("Godišnji odmor")
  zaposlenik          Zaposlenik @relation(fields: [zaposlenikId], references: [id])
}

model Korisnik {
  id           Int         @id @default(autoincrement())
  ime          String
  email        String      @unique
  lozinka      String
  uloga        String      @default("zaposlenik")
  zaposlenikId Int?        @unique
  odobren      Boolean     @default(false)
  zaposlenik   Zaposlenik? @relation(fields: [zaposlenikId], references: [id])
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

model NeradniDan {
  id    Int      @id @default(autoincrement())
  naziv String
  datum DateTime
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  korisnik  String
  akcija    String
  detalji   String?
  createdAt DateTime @default(now())
}

model GodisnjiObracun {
  id Int @id @default(autoincrement())

  godina Int

  zaposlenikId Int
  zaposlenik Zaposlenik @relation(fields: [zaposlenikId], references: [id])

  osnovica Int @default(20)

  dodatakStaz Int @default(0)
  dodatakDjeca Int @default(0)
  dodatakRadnoMjesto Int @default(0)
  dodatakRezultatRada Int @default(0)
  dodatakARBiH Int @default(0)

  ukupnoDana Int

  brojDjeceU15 Int @default(0)
  samohraniRoditelj Boolean @default(false)
  invaliditet Boolean @default(false)

  nivoSluzbenickogMjesta String
  ocjenaRezultata String
  mjeseciARBiH Int @default(0)

  datumObracuna DateTime @default(now())
}